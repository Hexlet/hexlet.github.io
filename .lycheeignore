# Статика Docusaurus живёт в static/, а ссылки на неё абсолютные (/img/...),
# поэтому от корня репозитория такие файлы не находятся. Битые пути внутри
# сайта ловит сама сборка: onBrokenLinks: 'throw' в docusaurus.config.ts.
^file://.*/img/

# Ozon отвечает бесконечной цепочкой 307 всему, что не браузер.
ozon\.ru

# Реферальная ссылка DigitalOcean: 400 на любой запрос без браузерных заголовков.
m\.do\.co

# Наши короткие ссылки на карточки книг ведут в Ozon, а он зацикливает 307.
ru\.hexlet\.io/link/

# Сертификаты от национального УЦ: curl и lychee видят ошибку TLS,
# в браузере сайт открывается.
tinkoff\.ru
sberbank\.com
